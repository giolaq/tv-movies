{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "skipLibCheck": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src"
  ]
